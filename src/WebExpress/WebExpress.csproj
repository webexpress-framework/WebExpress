<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>2.0.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ApplicationIcon>ufo.ico</ApplicationIcon>
		<Authors>webexpress-framework@outlook.com</Authors>
		<StartupObject>WebExpress.App.Program</StartupObject>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm;</RuntimeIdentifiers>
		<RepositoryUrl>https://github.com/webexpress-framework/WebExpress.Server</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<!-- under Visual Studio the package would start its sbom-tool.exe, which requires the .NET 8 runtime; GenerateSbomWithDotnet hands the work to the dotnet msbuild instead -->
		<GenerateSbom Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(Configuration)' == 'Release'">true</GenerateSbom>
		<SbomGenerationPackageVersion>$(PackageVersion)</SbomGenerationPackageVersion>
		<!-- scan only the restore graph, otherwise older packages lying in bin end up as dependencies -->
		<SbomGenerationBuildComponentPath>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)</SbomGenerationBuildComponentPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' != 'DebugLocal'">
		<PackageReference Include="WebExpress.WebApp" Version="2.0.0-alpha" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'DebugLocal'">
	  <ProjectReference Include="..\..\..\WebExpress.WebApp\src\WebExpress.WebApp\WebExpress.WebApp.csproj" />
	  <ProjectReference Include="..\..\..\WebExpress.WebCore\src\WebExpress.WebCore\WebExpress.WebCore.csproj" />
	  <ProjectReference Include="..\..\..\WebExpress.WebIndex\src\WebExpress.WebIndex\WebExpress.WebIndex.csproj" />
	  <ProjectReference Include="..\..\..\WebExpress.WebUI\src\WebExpress.WebUI\WebExpress.WebUI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="settings\webexpress.settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(Configuration)' == 'Release'">
		<Exec Command="$(SolutionDir)$(AssemblyName)\bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).exe -s $(SolutionDir)..\$(SolutionName).spec -c $(Configuration) -t $(TargetFramework) -o $(SolutionDir)..\pkg\$(Configuration)" />
	</Target>

	<Target Name="GenerateSbomWithDotnet" AfterTargets="Pack" Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(IsPackable)' == 'true' AND '$(Configuration)' == 'Release'">
		<Exec Command="dotnet msbuild &quot;$(MSBuildProjectFullPath)&quot; -nologo -v:m -t:GenerateSbomTarget -p:Configuration=$(Configuration)" />
	</Target>

	<!-- Microsoft.Sbom.Targets only embeds the manifest in the nupkg; copy it next to the package as well -->
	<Target Name="CopySbomToPackageOutput" AfterTargets="GenerateSbomTarget" Condition="'$(IsPackable)' == 'true' AND '$(GenerateSbom)' == 'true'">
		<!-- set inside the target because PackageId and PackageOutputPath are only defined after the project file is evaluated -->
		<PropertyGroup>
			<SbomUnzipPath>$(IntermediateOutputPath)sbom</SbomUnzipPath>
			<SbomFileName>$(PackageId.ToLowerInvariant())</SbomFileName>
		</PropertyGroup>
		<RemoveDir Directories="$(SbomUnzipPath)" />
		<Unzip SourceFiles="$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(SbomUnzipPath)" />
		<ItemGroup>
			<SbomFile Include="$(SbomUnzipPath)\_manifest\$(SbomSpecification)\manifest.spdx.json" TargetPath="$(PackageOutputPath)$(SbomFileName).spdx.json" />
			<SbomFile Include="$(SbomUnzipPath)\_manifest\$(SbomSpecification)\manifest.spdx.json.sha256" TargetPath="$(PackageOutputPath)$(SbomFileName).spdx.json.sha256" />
		</ItemGroup>
		<Copy SourceFiles="@(SbomFile)" DestinationFiles="@(SbomFile->'%(TargetPath)')" />
		<RemoveDir Directories="$(SbomUnzipPath)" />
	</Target>

</Project>
